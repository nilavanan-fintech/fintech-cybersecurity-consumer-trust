    {
      "id": 16,
      "type": "table",
      "title": "model_results (latest run)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT model, model_type AS type, ROUND(\"precision\"::numeric,3) AS \"precision\", ROUND(recall::numeric,3) AS recall, ROUND(f1::numeric,3) AS f1, ROUND(roc_auc::numeric,3) AS roc_auc, ROUND(pr_auc::numeric,3) AS pr_auc, ROUND(false_positive_rate::numeric,4) AS fpr, tp, fp, fn, tn FROM v_latest_model_results ORDER BY pr_auc DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {}
    }
