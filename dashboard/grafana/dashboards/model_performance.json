      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fintech_stream_outcomes_total{outcome=\"fp\"}[5m])) / clamp_min(sum(increase(fintech_stream_outcomes_total{outcome=~\"fp|tn\"}[5m])), 1)",
          "legendFormat": "FPR",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
