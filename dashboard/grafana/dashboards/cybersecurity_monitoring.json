      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fintech_stream_security_events_total{blocked=\"true\"}[2m])) / clamp_min(sum(rate(fintech_stream_security_events_total[2m])), 1e-9)",
