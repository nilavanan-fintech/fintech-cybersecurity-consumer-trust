# Copy to .env and change the secrets before sharing the stack beyond localhost.
# docker compose reads .env automatically.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=fintech
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=fintech_research
POSTGRES_PORT=5432

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
GRAFANA_PORT=3000

# --- JupyterLab -----------------------------------------------------------------
JUPYTER_TOKEN=change_me_jupyter
JUPYTER_PORT=8888

# --- Prometheus / exporters -------------------------------------------------------
PROMETHEUS_PORT=9090
LOKI_PORT=3100
CADVISOR_PORT=8081
EXPORTER_PORT=8000

# --- Research pipeline -------------------------------------------------------------
# 1 = retrain even if saved artefacts exist; 0 = reuse them on restart
FORCE_RETRAIN=0
# Salt used to pseudonymise survey respondent identifiers (keep secret, never commit)
SURVEY_SALT=change_me_survey_salt
